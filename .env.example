# Core app configuration
NODE_ENV=development
PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8005
API_PREFIX=/api

# Local SQLite database
LOCAL_DB_PATH=./data/educational_platform.db
DATABASE_PATH=./data/educational_platform.db
DATABASE_URL=sqlite:///./data/educational_platform.db

# Upload/media storage
UPLOAD_ROOT=public/uploads

# Frontend Vite env consumption
VITE_DATABASE_URL=sqlite:///./data/educational_platform.db
VITE_DB_PATH=./data/educational_platform.db
VITE_API_BASE_URL=http://127.0.0.1:8005
